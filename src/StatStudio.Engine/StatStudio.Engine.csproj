<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StatStudio.Engine</AssemblyName>
    <RootNamespace>StatStudio.Engine</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StatStudio.Core\StatStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ScottPlot base package (NOT ScottPlot.WPF): Plots.cs only uses the
         framework-agnostic ScottPlot.Plot API, rendered headlessly to PNG here. -->
    <PackageReference Include="ScottPlot" Version="5.1.58" />
  </ItemGroup>

  <!-- Graphs/Plots.cs is a local source file (auto-globbed by the SDK). -->

</Project>
